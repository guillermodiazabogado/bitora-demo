{
  admin off
  auto_https disable_redirects
}

bitora.localhost:443 {
  tls internal
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app-1:8787 app-2:8787 {
    lb_policy round_robin
    health_uri /ready
    health_interval 10s
    health_timeout 3s
    fail_duration 20s
  }
  log {
    output stdout
    format json
  }
}
