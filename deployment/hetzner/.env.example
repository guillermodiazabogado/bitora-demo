# Copy to deployment/hetzner/.env on the VPS. Never commit the real .env file.

APP_ENV=staging
BITORA_ENV=staging
BITORA_ENV_LABEL=BITORA HETZNER STAGING

# Public URL. Use either a real domain or a temporary DNS name pointed at the VPS.
BITORA_DOMAIN=staging.example.com
BASE_URL=https://staging.example.com
BITORA_PUBLIC_URL=https://staging.example.com
BITORA_ALLOWED_HOSTS=staging.example.com
BITORA_CORS_ORIGINS=https://staging.example.com

HTTPS_REQUIRED=true
QR_REQUIRE_LOGIN=true
BITORA_COOKIE_SECURE=true
BITORA_TRUST_PROXY=true

POSTGRES_DB=bitora_staging
POSTGRES_USER=bitora_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
QR_DB_ENGINE=postgres
DATABASE_ENGINE=postgres
QR_POSTGRES_POOL_MIN=1
QR_POSTGRES_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

SECRET_KEY=CHANGE_ME_GENERATED_SECRET
SESSION_SECRET=CHANGE_ME_GENERATED_SESSION_SECRET
BITORA_INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_GENERATED_32_BYTES_BASE64
BITORA_HEALTH_TOKEN=CHANGE_ME_GENERATED_HEALTH_TOKEN
BITORA_ADMIN_BOOTSTRAP_USER=bitora-admin
BITORA_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

BITORA_SAFE_MODE=true
BITORA_LIVE_MODE=false
BITORA_COMMUNICATIONS_LIVE_MODE_ENABLED=false

# R2 is recommended for staging files/certificates.
BITORA_STORAGE_PROVIDER=r2
STORAGE_BACKEND=r2
BITORA_STORAGE_PATH=/bitora/storage
BITORA_BACKUP_PATH=/bitora/backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=staging
R2_ENDPOINT=
R2_REGION=auto

QR_AUTO_BACKUP_MINUTES=0
QR_BACKUP_KEEP_LAST=48
BITORA_BACKUP_ENABLED=true
BITORA_DISABLE_EMBEDDED_WORKER=1

EMAIL_ENABLED=false
EMAIL_SAFE_MODE=true
EMAIL_PROVIDER=demo
EMAIL_FORCE_RECIPIENT=demo@bitora.test
EMAIL_TEST_RECIPIENT=demo@bitora.test

WHATSAPP_ENABLED=false
WHATSAPP_SAFE_MODE=true
WHATSAPP_PROVIDER=demo
WHATSAPP_FORCE_RECIPIENT=5491100000000
WHATSAPP_TEST_RECIPIENT=5491100000000
WHATSAPP_WEBHOOK_ENABLED=false

GOOGLE_OAUTH_ENABLED=false
CACHE_BACKEND=memory-ttl
