# BITORA Deployment Framework - staging example
# Copiar como deployment/staging/.env.staging. No subir el archivo real.

APP_ENV=staging
BASE_URL=http://localhost:8788
HTTPS_REQUIRED=false
PORT=8787
QR_HOST=0.0.0.0
QR_REQUIRE_LOGIN=1
BITORA_ENV_LABEL=BITORA STAGING
BITORA_INTEGRATION_ENCRYPTION_KEY=
BITORA_LIVE_INTEGRATIONS=false

QR_DB_ENGINE=postgres
QR_POSTGRES_DSN=postgresql://bitora_staging:bitora_staging_password@bitora-staging-postgres:5432/bitora_staging
DATABASE_ENGINE=postgres
DATABASE_URL=postgresql://bitora_staging:bitora_staging_password@bitora-staging-postgres:5432/bitora_staging
QR_POSTGRES_POOL_MIN=1
QR_POSTGRES_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

STORAGE_BACKEND=local
BITORA_STORAGE_PATH=/bitora/storage
BITORA_BACKUP_PATH=/bitora/backups
QR_AUTO_BACKUP_MINUTES=10
QR_BACKUP_KEEP_LAST=48

BITORA_DISABLE_EMBEDDED_WORKER=1
BDF_WORKER_LIVE=1
BDF_STAGING_LIVE=1

BITORA_SURVEYS_V4_ENABLED=false
BITORA_SPEAKERS_V4_ENABLED=false
BITORA_ZONE_PERMISSIONS_V4_ENABLED=false
BITORA_HISTORY_AUTOCOMPLETE_V4_ENABLED=false
BITORA_SURVEY_SECRET=staging-survey-secret-change-me

EMAIL_PROVIDER=resend
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM=BITORA STAGING <staging@example.test>
EMAIL_REPLY_TO=staging@example.test
EMAIL_SAFE_MODE=true
EMAIL_FORCE_RECIPIENT=staging@example.test
EMAIL_TEST_RECIPIENT=staging@example.test
EMAIL_MAX_BATCH_SIZE=50
EMAIL_RATE_LIMIT=60
EMAIL_MAX_RETRIES=3
EMAIL_TIMEOUT_SECONDS=15
EMAIL_WEBHOOK_SECRET=staging-email-webhook-secret

WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=staging-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_WEBHOOK_PUBLIC_URL=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_META_API_URL=https://graph.facebook.com/v22.0
WHATSAPP_SAFE_MODE=true
WHATSAPP_FORCE_RECIPIENT=5491100000000
WHATSAPP_TEST_RECIPIENT=5491100000000
WHATSAPP_MAX_BATCH_SIZE=50
WHATSAPP_RATE_LIMIT=60
WHATSAPP_MAX_RETRIES=3
WHATSAPP_TIMEOUT_SECONDS=15
WHATSAPP_REGISTRATION_TEMPLATE=
WHATSAPP_REGISTRATION_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_REGISTRATION_TEMPLATE_VARIABLES=nombre,evento,portal
WHATSAPP_LIVE_RECEIPT_CONFIRMED=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8788/api/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_OAUTH_STATE_TTL_MINUTES=10
META_OAUTH_REDIRECT_URI=http://localhost:8788/api/integrations/meta/oauth/callback

CACHE_BACKEND=memory-ttl
