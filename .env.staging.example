# BITORA STAGING - ejemplo sin secretos reales
# Copiar como .env.staging fuera de Git y completar valores locales/Render/Railway.

APP_ENV=staging
BASE_URL=https://bitora-staging.example.test
HTTPS_REQUIRED=true
PORT=8787
QR_HOST=0.0.0.0
QR_REQUIRE_LOGIN=1

# PostgreSQL live de staging
QR_DB_ENGINE=postgres
QR_POSTGRES_DSN=postgresql://bitora_staging:CAMBIAR_PASSWORD@bitora-staging-postgres:5432/bitora_staging
QR_POSTGRES_POOL_MIN=1
QR_POSTGRES_POOL_MAX=10
DATABASE_ENGINE=postgres
DATABASE_URL=postgresql://bitora_staging:CAMBIAR_PASSWORD@bitora-staging-postgres:5432/bitora_staging
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# Storage y backups persistentes aislados
STORAGE_BACKEND=local
BITORA_STORAGE_PATH=/bitora/storage
BITORA_BACKUP_PATH=/bitora/backups
QR_AUTO_BACKUP_MINUTES=10
QR_BACKUP_KEEP_LAST=48

# Comunicaciones en safe mode obligatorio
EMAIL_PROVIDER=resend
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM=BITORA STAGING <staging@example.test>
EMAIL_REPLY_TO=staging@example.test
EMAIL_SAFE_MODE=true
EMAIL_FORCE_RECIPIENT=staging@example.test
EMAIL_TEST_RECIPIENT=staging@example.test
EMAIL_MAX_BATCH_SIZE=50
EMAIL_RATE_LIMIT=60
EMAIL_MAX_RETRIES=3
EMAIL_TIMEOUT_SECONDS=15
EMAIL_WEBHOOK_SECRET=staging-email-webhook-secret

WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=staging-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_SAFE_MODE=true
WHATSAPP_FORCE_RECIPIENT=5491100000000
WHATSAPP_TEST_RECIPIENT=5491100000000
WHATSAPP_MAX_BATCH_SIZE=50
WHATSAPP_RATE_LIMIT=60
WHATSAPP_MAX_RETRIES=3
WHATSAPP_TIMEOUT_SECONDS=15

# Cache local reproducible para staging
CACHE_BACKEND=memory-ttl
