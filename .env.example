# BITORA - ejemplo de variables para despliegue
# Copiar como .env solo en entornos locales. En Render/Railway se cargan desde el panel.

APP_ENV=demo
BASE_URL=https://bitora-demo.onrender.com
HTTPS_REQUIRED=true

# Render/Railway asignan PORT automaticamente. En local se puede usar QR_PORT=8787.
PORT=10000
QR_HOST=0.0.0.0

# Base de datos. SQLite para local/demo; PostgreSQL para online seria/produccion.
QR_DB_ENGINE=sqlite
QR_SQLITE_PATH=acreditaciones.sqlite3
QR_POSTGRES_DSN=
QR_POSTGRES_POOL_MIN=1
QR_POSTGRES_POOL_MAX=10
DATABASE_ENGINE=
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# Seguridad operativa
QR_REQUIRE_LOGIN=1

# Backups locales de SQLite
QR_AUTO_BACKUP_MINUTES=10
QR_BACKUP_KEEP_LAST=24

# Email real. Mantener EMAIL_ENABLED=false hasta verificar dominio y remitente.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=BITORA <eventos@tu-dominio.com>
EMAIL_FROM_NAME=BITORA
EMAIL_FROM_ADDRESS=eventos@tu-dominio.com
EMAIL_REPLY_TO=
EMAIL_ENABLED=false
EMAIL_VERIFIED_DOMAIN=
EMAIL_SAFE_MODE=true
EMAIL_FORCE_RECIPIENT=
EMAIL_TEST_RECIPIENT=
EMAIL_MAX_BATCH_SIZE=50
EMAIL_RATE_LIMIT=60
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_TIMEOUT_SECONDS=15
EMAIL_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MAX_RETRIES=3
WHATSAPP_REGISTRATION_TEMPLATE=
WHATSAPP_REGISTRATION_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_REGISTRATION_TEMPLATE_VARIABLES=nombre,evento,portal

# Storage portable. En produccion local debe apuntar a disco persistente.
STORAGE_BACKEND=local
BITORA_STORAGE_PATH=storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cache futuro. Actualmente disabled es valido.
CACHE_BACKEND=disabled
